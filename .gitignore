# Compiled class file                                 
  *.class              
         
  # Log file
  *.log     
       
  # BlueJ files
  *.ctxt                                                                                                                                                                                      
        
  # Mobile Tools for Java (J2ME)                                                                                                                                                              
  .mtj.tmp/                                             
           
  # Package Files #
  *.jar            
  *.war
  *.nar
  *.ear
  *.zip
  *.tar.gz
  *.rar   
       
  # Virtual machine crash logs
  hs_err_pid*                                                                                                                                                                                 
  replay_pid*
                                                                                                                                                                                              
  # Spring Boot secrets - never commit                  
  backend/src/main/resources/application.properties
                                                   
  # Docker & environment secrets - never commit
  .env                                         
  .env.local
  .env.production

  # Frontend                                                                                                                                                                                  
  frontend/node_modules/
  frontend/dist/                                                                                                                                                                              
                                                        
  # IDE files
  .idea/
  .vscode/
  *.iml